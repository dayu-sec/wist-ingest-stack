# 手工 `docker compose` 使用的默认值；`gops sys localize` 会生成同名 .env。
WARP_SPC=ghcr.io/wp-labs
WPARSE_TAG=0.35.3-alpha

INGEST_SPC=ghcr.io/dayu-sec
INGEST_WEB_TAG=v0.2.0
INGEST_CTRL_TAG=v0.3.0
# 本机镜像覆盖（开发态）：留空 = 用 ${INGEST_SPC}/wist-ingest-ctrl:${INGEST_CTRL_TAG}。
# 本地 `docker build` 出来的镜像**没有 registry**，写普通名字（如 wist-ingest-ctrl:v0.3.0-local），
# 不要伪造成 ghcr.io/... —— 那种 tag 一 pull 就是 not found。
INGEST_CTRL_IMAGE=

# 数据面入口：公网可达，默认 6514
INGEST_BIND_IP=0.0.0.0
INGEST_PORT=6514
# 交给网关的入口主机名（advertise 的 host；端口取 INGEST_PORT）。留空 = 由 bind 推导
INGEST_ADVERTISE_HOST=

# 管理台只给内网/回环；WEB_DOMAIN = 证书 SAN 里的域名（`https://<WEB_DOMAIN>:<WEB_PORT>/`）
WEB_BIND_IP=127.0.0.1
WEB_PORT=18080
WEB_DOMAIN=localhost

# 访问凭据（wist-cred 验证方）收数 listener：cred → ctrl。默认只绑回环。
CRED_BIND_IP=127.0.0.1
CRED_PORT=19092

TZ=Asia/Shanghai
